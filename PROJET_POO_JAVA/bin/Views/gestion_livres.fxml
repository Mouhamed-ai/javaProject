<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Line?>

<HBox prefHeight="650.0" prefWidth="1100.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.LivreController">
   <children>
      
      <!-- SIDEBAR -->
      <VBox prefWidth="250.0" styleClass="sidebar">
         <children>
            <VBox alignment="CENTER" prefHeight="150.0" spacing="10.0">
               <children>
                  <Label text="UGB LIB" textFill="#e74c3c">
                     <font><Font name="System Bold" size="32.0" /></font>
                  </Label>
                  <Label text="BIBLIOTHÈQUE" textFill="WHITE" />
                  <Line endX="100.0" stroke="#333333" />
               </children>
            </VBox>

            <VBox spacing="10.0" style="-fx-padding: 20;">
               <children>
                  <Button alignment="BASELINE_LEFT" prefHeight="45.0" prefWidth="210.0" styleClass="btn-red" text="📚  Gestion des Livres" />
                  <Button alignment="BASELINE_LEFT" prefHeight="45.0" prefWidth="210.0" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7;" text="👥  Utilisateurs" />
                  <Button alignment="BASELINE_LEFT" prefHeight="45.0" prefWidth="210.0" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7;" text="🔄  Emprunts" />
               </children>
            </VBox>
         </children>
      </VBox>

      <!-- CONTENU PRINCIPAL -->
      <VBox spacing="20.0" style="-fx-background-color: white;" HBox.hgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-border-color: #f1f1f1; -fx-border-width: 0 0 1 0;">
               <children>
                  <Label text="Administration / Stock des Livres" textFill="#2c3e50">
                     <font><Font name="System Bold" size="20.0" /></font>
                  </Label>
               </children>
               <padding><Insets left="30.0" /></padding>
            </HBox>

            <!-- Formulaire -->
            <VBox spacing="15.0" style="-fx-border-color: #e0e0e0; -fx-border-radius: 10; -fx-padding: 20;">
               <children>
                  <HBox spacing="15.0">
                     <children>
                        <VBox HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Titre du livre" textFill="#7f8c8d" />
                              <TextField fx:id="txtTitre" prefHeight="35.0" />
                           </children>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Auteur" textFill="#7f8c8d" />
                              <TextField fx:id="txtAuteur" prefHeight="35.0" />
                           </children>
                        </VBox>
                        <VBox>
                           <children>
                              <Label text="ISBN" textFill="#7f8c8d" />
                              <TextField fx:id="txtIsbn" prefHeight="35.0" prefWidth="150.0" />
                           </children>
                        </VBox>
                        <VBox>
                           <children>
                              <Label text="Qté" textFill="#7f8c8d" />
                              <TextField fx:id="txtQte" prefHeight="35.0" prefWidth="80.0" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_RIGHT" spacing="15.0">
                     <children>
                        <Button onAction="#handleActualiser" prefHeight="35.0" prefWidth="110.0" style="-fx-background-color: #eee;" text="Actualiser" />
                        <Button onAction="#handleSupprimer" prefHeight="35.0" prefWidth="110.0" styleClass="btn-black" text="Supprimer" />
                        <Button onAction="#handleAjouter" prefHeight="35.0" prefWidth="180.0" styleClass="btn-red" text="+ AJOUTER AU STOCK" />
                     </children>
                  </HBox>
               </children>
               <VBox.margin><Insets left="30.0" right="30.0" /></VBox.margin>
            </VBox>

            <!-- Recherche -->
            <HBox spacing="15.0">
               <children>
                  <TextField fx:id="txtRecherche" onKeyReleased="#handleRechercher" prefHeight="45.0" placeholder="🔍 Rechercher par titre, auteur ou ISBN..." styleClass="search-bar" HBox.hgrow="ALWAYS" />
               </children>
               <VBox.margin><Insets left="30.0" right="30.0" /></VBox.margin>
            </HBox>

            <!-- Tableau -->
            <TableView fx:id="tableLivres" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colTitre" prefWidth="300.0" text="TITRE DU LIVRE" />
                <TableColumn fx:id="colAuteur" prefWidth="220.0" text="AUTEUR" />
                <TableColumn fx:id="colIsbn" prefWidth="150.0" text="ISBN" />
                <TableColumn fx:id="colQte" prefWidth="100.0" text="EN STOCK" />
              </columns>
               <VBox.margin><Insets bottom="30.0" left="30.0" right="30.0" /></VBox.margin>
            </TableView>
         </children>
      </VBox>
   </children>
</HBox>